rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Keep in sync with ADMIN_UIDS in frontend/src/utils/adminConfig.ts
    function isAdmin() {
      return request.auth != null
          && request.auth.uid in [
            'JqzlnoRP7teD5HS96B7SUIp2Tyg2',
            'ZmJn94M9cEdTjju2GXH2GCkkRRl1'
          ];
    }

    // Pixel character art: any signed-in user can view it, only admins can upload/change it.
    match /pixelCharacters/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Pixel journal creature art: same policy as pixelCharacters.
    match /pixelJournal/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // User-owned lesson files
    match /users/{userId}/lessons/{allPaths=**} {
      allow read, write: if request.auth != null
                        && request.auth.uid == userId;
    }

    // Everything else (unchanged): signed-in users. pixelCharacters is excluded here
    // because overlapping Storage rules are OR'd together and would otherwise let any
    // signed-in user write there.
    match /{topFolder}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                  && topFolder != 'pixelCharacters'
                  && topFolder != 'pixelJournal';
    }
  }
}
